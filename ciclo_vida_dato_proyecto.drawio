<mxfile host="app.diagrams.net"><diagram id="ciclo-vida-dato" name="Ciclo de vida del dato"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1470" pageHeight="908" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Ciclo de vida del dato · Análisis de patrones de acceso del despacho&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="1200" height="34" as="geometry"/></mxCell><mxCell id="sub" value="Seis etapas, con responsable y control por etapa. Dato de mayor riesgo seguido: D2 «nombre»." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1200" height="24" as="geometry"/></mxCell><mxCell id="chip" value="&lt;b&gt;D2 · nombre (mayor riesgo)&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#dc2626;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="210" height="28" as="geometry"/></mxCell><mxCell id="stage1" value="&lt;b&gt;1. Captura&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1e40af;strokeWidth=2;fontSize=15;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="40" y="152" width="210" height="52" as="geometry"/></mxCell><mxCell id="stage2" value="&lt;b&gt;2. Almacenamiento&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1e40af;strokeWidth=2;fontSize=15;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="276" y="152" width="210" height="52" as="geometry"/></mxCell><mxCell id="stage3" value="&lt;b&gt;3. Uso&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1e40af;strokeWidth=2;fontSize=15;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="512" y="152" width="210" height="52" as="geometry"/></mxCell><mxCell id="stage4" value="&lt;b&gt;4. Compartición&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1e40af;strokeWidth=2;fontSize=15;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="748" y="152" width="210" height="52" as="geometry"/></mxCell><mxCell id="stage5" value="&lt;b&gt;5. Retención&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1e40af;strokeWidth=2;fontSize=15;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="984" y="152" width="210" height="52" as="geometry"/></mxCell><mxCell id="stage6" value="&lt;b&gt;6. Eliminación&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1e40af;strokeWidth=2;fontSize=15;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="1220" y="152" width="210" height="52" as="geometry"/></mxCell><mxCell id="desc1" value="&lt;b&gt;Qué ocurre:&lt;/b&gt; Recepción anota en la bitácora los datos D1–D9 de cada visitante o proveedor que entra.&lt;br&gt;&lt;br&gt;&lt;b&gt;Responsable:&lt;/b&gt; Personal de recepción (dueño del proceso: Líder del proyecto).&lt;br&gt;&lt;br&gt;&lt;b&gt;Control:&lt;/b&gt;&lt;br&gt;• Aviso de privacidad visible antes de registrar&lt;br&gt;• Captura mínima: solo los datos D1–D9&lt;br&gt;• Validación de formato al capturar (correo, 10 dígitos, fecha real)&lt;br&gt;• &lt;font color=&quot;#1d4ed8&quot;&gt;(+) Casilla «leí el aviso» como evidencia de consentimiento&lt;/font&gt;&lt;br&gt;• &lt;font color=&quot;#1d4ed8&quot;&gt;(+) Leyenda: un sistema de IA analiza los accesos&lt;/font&gt;&lt;br&gt;• &lt;font color=&quot;#1d4ed8&quot;&gt;(+) Canal para oponerse y pedir revisión humana&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;strokeColor=#9ca3af;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="210" height="392" as="geometry"/></mxCell><mxCell id="desc2" value="&lt;b&gt;Qué ocurre:&lt;/b&gt; La bitácora cruda (D1–D9) vive en una hoja de cálculo en la nube del despacho. La tabla de seudónimos (D11) se guarda aparte.&lt;br&gt;&lt;br&gt;&lt;b&gt;Responsable:&lt;/b&gt; Administrador del sistema.&lt;br&gt;&lt;br&gt;&lt;b&gt;Control:&lt;/b&gt;&lt;br&gt;• Cifrado en reposo&lt;br&gt;• Acceso por rol con doble factor (2FA)&lt;br&gt;• Respaldo cifrado&lt;br&gt;• D11 fuera de la nube compartida, con acceso restringido" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;strokeColor=#9ca3af;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="276" y="232" width="210" height="392" as="geometry"/></mxCell><mxCell id="desc3" value="&lt;b&gt;Qué ocurre:&lt;/b&gt; El equipo trabaja sobre una copia: limpia, seudonimiza D2 → P###, generaliza D5, D6 y D8 y busca accesos inusuales.&lt;br&gt;&lt;br&gt;&lt;b&gt;Responsable:&lt;/b&gt; Equipo de análisis (supervisa: Líder del proyecto).&lt;br&gt;&lt;br&gt;&lt;b&gt;Control:&lt;/b&gt;&lt;br&gt;• Uso limitado al fin declarado (patrones de acceso)&lt;br&gt;• Registro de accesos al archivo de trabajo&lt;br&gt;• Prueba de combinaciones únicas tras generalizar&lt;br&gt;• &lt;font color=&quot;#1d4ed8&quot;&gt;(+) Registro de riesgos aprobado antes de operar&lt;/font&gt;&lt;br&gt;• &lt;font color=&quot;#1d4ed8&quot;&gt;(+) Revisión humana de cada alerta, sin acciones automáticas&lt;/font&gt;&lt;br&gt;• &lt;font color=&quot;#1d4ed8&quot;&gt;(+) Revisión trimestral de sesgos por empresa, área y franja&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;strokeColor=#9ca3af;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="512" y="232" width="210" height="392" as="geometry"/></mxCell><mxCell id="desc4" value="&lt;b&gt;Qué ocurre:&lt;/b&gt; Solo el dataset anonimizado (sin D2, D3 ni D4) va a un modelo generativo y a GitHub. Nada crudo sale.&lt;br&gt;&lt;br&gt;&lt;b&gt;Responsable:&lt;/b&gt; Responsable de privacidad.&lt;br&gt;&lt;br&gt;&lt;b&gt;Control:&lt;/b&gt;&lt;br&gt;• Lista de chequeo de anonimización antes de cada envío&lt;br&gt;• Entrenamiento del proveedor desactivado&lt;br&gt;• D11 y bitácora cruda nunca se envían&lt;br&gt;• &lt;font color=&quot;#1d4ed8&quot;&gt;(+) Registro de terceros: qué reciben y bajo qué términos&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;strokeColor=#9ca3af;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="748" y="232" width="210" height="392" as="geometry"/></mxCell><mxCell id="desc5" value="&lt;b&gt;Qué ocurre:&lt;/b&gt; Bitácora cruda: máximo 90 días. Dataset anonimizado y D11: hasta el cierre del proyecto.&lt;br&gt;&lt;br&gt;&lt;b&gt;Responsable:&lt;/b&gt; Responsable de privacidad.&lt;br&gt;&lt;br&gt;&lt;b&gt;Control:&lt;/b&gt;&lt;br&gt;• Plazo definido por tipo de dato&lt;br&gt;• Revisión trimestral del inventario" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;strokeColor=#9ca3af;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="984" y="232" width="210" height="392" as="geometry"/></mxCell><mxCell id="desc6" value="&lt;b&gt;Qué ocurre:&lt;/b&gt; Al vencer el plazo se borran crudo, copias, respaldos y D11; se pide al proveedor purgar papelera y versiones.&lt;br&gt;&lt;br&gt;&lt;b&gt;Responsable:&lt;/b&gt; Administrador del sistema (verifica: Responsable de privacidad).&lt;br&gt;&lt;br&gt;&lt;b&gt;Control:&lt;/b&gt;&lt;br&gt;• Borrado seguro, incluidos respaldos y versiones&lt;br&gt;• Acta de eliminación (confirmación documentada)&lt;br&gt;• Borrar los chats del modelo generativo (el proveedor los purga hasta en 30 días)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;strokeColor=#9ca3af;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1220" y="232" width="210" height="392" as="geometry"/></mxCell><mxCell id="c3" value="" style="edgeStyle=none;html=1;strokeColor=#111827;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="stage1" target="stage2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c4" value="" style="edgeStyle=none;html=1;strokeColor=#111827;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="stage2" target="stage3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c5" value="" style="edgeStyle=none;html=1;strokeColor=#111827;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="stage3" target="stage4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="" style="edgeStyle=none;html=1;strokeColor=#111827;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="stage4" target="stage5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="" style="edgeStyle=none;html=1;strokeColor=#111827;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="stage5" target="stage6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=none;html=1;strokeColor=#dc2626;strokeWidth=3;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="chip" target="stage1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="D2 nombre" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#dc2626;strokeWidth=3;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;fontColor=#dc2626;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="stage1" target="stage2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="145" y="130"/><mxPoint x="381" y="130"/></Array></mxGeometry></mxCell><mxCell id="c10" value="D2 (crudo)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#dc2626;strokeWidth=3;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;fontColor=#dc2626;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="stage2" target="stage3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="381" y="130"/><mxPoint x="617" y="130"/></Array></mxGeometry></mxCell><mxCell id="c11" value="P### (seudónimo de D2)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#dc2626;strokeWidth=3;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;fontColor=#dc2626;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="stage3" target="stage4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="617" y="130"/><mxPoint x="853" y="130"/></Array></mxGeometry></mxCell><mxCell id="c12" value="D2 crudo y D11, en reposo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#dc2626;strokeWidth=3;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;fontColor=#dc2626;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="stage4" target="stage5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="853" y="130"/><mxPoint x="1089" y="130"/></Array></mxGeometry></mxCell><mxCell id="c13" value="D2 y D11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#dc2626;strokeWidth=3;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;fontColor=#dc2626;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="stage5" target="stage6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1089" y="130"/><mxPoint x="1325" y="130"/></Array></mxGeometry></mxCell><mxCell id="third1" value="&lt;b&gt;Proveedor de nube&lt;/b&gt;&lt;br&gt;hoja de cálculo: recibe D1–D9 en reposo" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;strokeColor=#dc2626;strokeWidth=2;fillColor=#fff5f5;fontSize=11;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="276" y="662" width="210" height="54" as="geometry"/></mxCell><mxCell id="third2" value="&lt;b&gt;Modelo generativo&lt;/b&gt;&lt;br&gt;recibe solo P### y datos anonimizados" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;strokeColor=#dc2626;strokeWidth=2;fillColor=#fff5f5;fontSize=11;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="748" y="662" width="190" height="54" as="geometry"/></mxCell><mxCell id="third3" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;solo CSV anonimizado y documentos" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;strokeColor=#dc2626;strokeWidth=2;fillColor=#fff5f5;fontSize=11;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="748" y="740" width="190" height="54" as="geometry"/></mxCell><mxCell id="third4" value="&lt;b&gt;Proveedor de nube&lt;/b&gt;&lt;br&gt;guarda los respaldos" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;strokeColor=#dc2626;strokeWidth=2;fillColor=#fff5f5;fontSize=11;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="984" y="662" width="210" height="54" as="geometry"/></mxCell><mxCell id="third5" value="&lt;b&gt;Proveedor de nube&lt;/b&gt;&lt;br&gt;papelera y versiones" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;strokeColor=#dc2626;strokeWidth=2;fillColor=#fff5f5;fontSize=11;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="1220" y="662" width="210" height="54" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=none;html=1;dashed=1;strokeColor=#dc2626;strokeWidth=2.4;endArrow=block;endFill=1;exitX=0.500;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="desc2" target="third1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=none;html=1;dashed=1;strokeColor=#dc2626;strokeWidth=2.4;endArrow=block;endFill=1;exitX=0.381;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="desc4" target="third2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#dc2626;strokeWidth=2.4;endArrow=block;endFill=1;exitX=0.96;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="desc4" target="third3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=none;html=1;dashed=1;strokeColor=#dc2626;strokeWidth=2.4;endArrow=block;endFill=1;exitX=0.500;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="desc5" target="third4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=none;html=1;dashed=1;strokeColor=#dc2626;strokeWidth=2.4;endArrow=block;endFill=1;exitX=0.500;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="desc6" target="third5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note" value="&lt;b&gt;Primera salida del control de la organización: Almacenamiento (proveedor de nube).  Terceros distintos: 3; apariciones en el ciclo: 5.&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="1300" height="24" as="geometry"/></mxCell><mxCell id="leg1" value="&lt;b&gt;—▶&lt;/b&gt; Recorrido del dato de mayor riesgo (D2) &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;b&gt;- - -&lt;/b&gt; Tercero: fuera del control directo del despacho &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#1d4ed8&quot;&gt;&lt;b&gt;(+) azul&lt;/b&gt;&lt;/font&gt; Control agregado tras cruzar con la matriz (7 de 25)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="846" width="1380" height="28" as="geometry"/></mxCell><mxCell id="leg2" value="D1–D12: ver inventario_datos_proyecto.xlsx. P### = seudónimo; D11 = tabla de seudónimos (se guarda aparte)." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="874" width="1380" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>